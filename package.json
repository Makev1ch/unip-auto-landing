{
  "name": "unip-auto-landing",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node -e \"const fs=require('fs');const path=require('path');const ensure=(p)=>fs.mkdirSync(p,{recursive:true});const cp=(src,dst)=>{ensure(path.dirname(dst));fs.cpSync(src,dst,{recursive:true,force:true});};cp(path.join('.next','static'),path.join('.next','standalone','.next','static'));cp('public',path.join('.next','standalone','public'));\"",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "framer-motion": "^12.34.1",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
